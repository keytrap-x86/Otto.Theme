<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Size</OptimizationPreference>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <PublishDir>bin\Release\net10.0\publish\win-x64\</PublishDir>
    <PublishUrl>$(PublishDir)</PublishUrl>
  </PropertyGroup>

  <!-- Native dependency packages can publish PDBs as runtime assets even when
       CopyOutputSymbolsToPublishDirectory is false. Keep them for debugging,
       outside the distributable folder, along with the AOT executable's PDB. -->
  <Target Name="SeparateNativePublishSymbols" AfterTargets="ComputeFilesToPublish"
          Condition="'$(PublishAot)' == 'true'">
    <PropertyGroup>
      <NativeSymbolsDir Condition="'$(NativeSymbolsDir)' == ''">$(MSBuildProjectDirectory)\..\artifacts\symbols\$(RuntimeIdentifier)\</NativeSymbolsDir>
      <NativeSymbolsDir>$([MSBuild]::EnsureTrailingSlash('$(NativeSymbolsDir)'))</NativeSymbolsDir>
    </PropertyGroup>
    <ItemGroup>
      <_OttoPublishSymbols Include="@(ResolvedFileToPublish)"
                           Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
      <ResolvedFileToPublish Remove="@(_OttoPublishSymbols)" />
      <_OttoPublishSymbols Include="$(NativeOutputPath)$(TargetName).pdb"
                           Condition="Exists('$(NativeOutputPath)$(TargetName).pdb')" />
    </ItemGroup>
    <MakeDir Directories="$(NativeSymbolsDir)" />
    <Copy SourceFiles="@(_OttoPublishSymbols)" DestinationFolder="$(NativeSymbolsDir)"
          SkipUnchangedFiles="true" />
    <!-- Older SDK publishes copied this file outside the regular cleanup list. -->
    <Delete Files="$(PublishDir)$(TargetName).pdb"
            Condition="Exists('$(NativeSymbolsDir)$(TargetName).pdb')" />
  </Target>
</Project>
