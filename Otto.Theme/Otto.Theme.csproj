<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Version>2.0.0</Version>
    <PackageId>Otto.Theme.WPF</PackageId>
    <Authors>Keytrap</Authors>
    <Description>Light and dark WPF themes with semantic color tokens for .NET 10.</Description>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/keytrap-x86/Otto.Theme</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Fonts\*.otf" />
    <Resource Include="Resources\Images\GlowWindow\*.png" />
    <None Include="..\readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
