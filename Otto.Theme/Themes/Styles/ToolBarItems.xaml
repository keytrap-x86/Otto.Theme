<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Otto.Theme;component/Themes/Styles/Base/ButtonBaseStyle.xaml" />
        <ResourceDictionary Source="/Otto.Theme;component/Themes/Styles/Base/CheckBoxBaseStyle.xaml" />
        <ResourceDictionary Source="/Otto.Theme;component/Themes/Styles/Base/ComboBoxBaseStyle.xaml" />
        <ResourceDictionary Source="/Otto.Theme;component/Themes/Styles/Base/TextBoxBaseStyle.xaml" />
        <ResourceDictionary Source="/Otto.Theme;component/Themes/Styles/Base/MenuBaseStyle.xaml" />
        <ResourceDictionary Source="/Otto.Theme;component/Themes/Styles/SelectionControls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ToolBar replaces implicit child styles with these component resource keys. -->
    <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style x:Key="{x:Static ToolBar.ToggleButtonStyleKey}" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonBaseStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style x:Key="{x:Static ToolBar.CheckBoxStyleKey}" TargetType="CheckBox" BasedOn="{StaticResource CheckBoxBaseStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="6,2" />
    </Style>
    <Style x:Key="{x:Static ToolBar.RadioButtonStyleKey}" TargetType="RadioButton" BasedOn="{StaticResource RadioButtonBaseStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="6,2" />
    </Style>
    <Style x:Key="{x:Static ToolBar.ComboBoxStyleKey}" TargetType="ComboBox" BasedOn="{StaticResource ComboBoxBaseStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="MinWidth" Value="100" />
    </Style>
    <Style x:Key="{x:Static ToolBar.TextBoxStyleKey}" TargetType="TextBox" BasedOn="{StaticResource TextBoxBaseStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="MinWidth" Value="100" />
    </Style>
    <Style x:Key="{x:Static ToolBar.MenuStyleKey}" TargetType="Menu" BasedOn="{StaticResource MenuBaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
    </Style>
</ResourceDictionary>
