<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PrimaryLightColor">#5F8AFA</Color>
    <Color x:Key="PrimaryColor">#2C5FF7</Color>
    <Color x:Key="PrimaryDarkColor">#2048D4</Color>

    <Color x:Key="WarningLightColor">#fcc569</Color>
    <Color x:Key="WarningColor">#fbb848</Color>
    <Color x:Key="WarningDarkColor">#faab27</Color>

    <Color x:Key="ErrorLightColor">#f15757</Color>
    <Color x:Key="ErrorColor">#f04747</Color>
    <Color x:Key="ErrorDarkColor">#ed2828</Color>

    <Color x:Key="InfoLightColor">#809ad0</Color>
    <Color x:Key="InfoColor">#6786c7</Color>
    <Color x:Key="InfoDarkColor">#4e72be</Color>

    <Color x:Key="SuccessLightColor">#59c192</Color>
    <Color x:Key="SuccessColor">#43B581</Color>
    <Color x:Key="SuccessDarkColor">#3a9c6f</Color>

    <Color x:Key="PrimaryTextColor">#E4E6EB</Color>
