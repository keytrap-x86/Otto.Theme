    <Color x:Key="DarkestColor">#18191C</Color>
    <Color x:Key="EffectShadowColor">#88000000</Color>
    <!-- Semantic tokens shared with the Avalonia theme. -->
    <Color x:Key="OnAccentColor">#FFFFFF</Color>
    <Color x:Key="OnSuccessColor">#101A14</Color>
    <Color x:Key="OnWarningColor">#201600</Color>
    <Color x:Key="OnErrorColor">#141617</Color>
