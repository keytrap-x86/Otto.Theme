    <Color x:Key="BackgroundDarkColor">#141617</Color>
    <Color x:Key="BackgroundColor">#23272A</Color>
    <Color x:Key="BackgroundLightColor">#32383d</Color>

    <!--#region Control Properties Colors-->

    <!--  Foreground  -->
    <Color x:Key="ControlForegroundColor">#E4E6EB</Color>
    <Color x:Key="ControlFocusedForegroundColor">#E4E6EB</Color>
    <Color x:Key="ControlHoveredForegroundColor">#E4E6EB</Color>
    <Color x:Key="ControlReadOnlyForegroundColor">#E4E6EB</Color>
    <Color x:Key="ControlDisabledForegroundColor">#E4E6EB</Color>

    <!--  Background  -->
    <Color x:Key="ControlBackgroundColor">#303339</Color>
    <Color x:Key="ControlFocusedBackgroundColor">#303339</Color>
    <Color x:Key="ControlHoveredBackgroundColor">#383b42</Color>
    <Color x:Key="ControlReadOnlyBackgroundColor">#202327</Color>
    <Color x:Key="ControlDisabledBackgroundColor">#202327</Color>

    <!--  Border  -->
    <Color x:Key="ControlBorderColor">#202020</Color>
    <Color x:Key="ControlFocusedBorderColor">#2C5FF7</Color>
    <Color x:Key="ControlHoveredBorderColor">#2C5FF7</Color>
    <Color x:Key="ControlReadOnlyBorderColor">#303339</Color>
    <Color x:Key="ControlDisabledBorderColor">#303339</Color>

