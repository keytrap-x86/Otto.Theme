<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:o="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <SolidColorBrush
        x:Key="DarkestBrush"
        Color="{DynamicResource DarkestColor}" />

    <SolidColorBrush
        x:Key="LightPrimaryBrush"
        Color="{DynamicResource PrimaryLightColor}" />
    <SolidColorBrush
        x:Key="PrimaryBrush"
        Color="{DynamicResource PrimaryColor}" />
    <SolidColorBrush
        x:Key="DarkPrimaryBrush"
        Color="{DynamicResource PrimaryDarkColor}" />

    <SolidColorBrush
        x:Key="LightSuccessBrush"
        Color="{DynamicResource SuccessLightColor}" />
    <SolidColorBrush
        x:Key="SuccessBrush"
        Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush
        x:Key="DarkSuccessBrush"
        Color="{DynamicResource SuccessDarkColor}" />

    <SolidColorBrush
        x:Key="LightInfoBrush"
        Color="{DynamicResource InfoLightColor}" />
    <SolidColorBrush
        x:Key="InfoBrush"
        Color="{DynamicResource InfoColor}" />
    <SolidColorBrush
        x:Key="DarkInfoBrush"
        Color="{DynamicResource InfoDarkColor}" />

    <SolidColorBrush
        x:Key="LightErrorBrush"
        Color="{DynamicResource ErrorLightColor}" />
    <SolidColorBrush
        x:Key="ErrorBrush"
        Color="{DynamicResource ErrorColor}" />
    <SolidColorBrush
        x:Key="DarkErrorBrush"
        Color="{DynamicResource ErrorDarkColor}" />

    <SolidColorBrush
        x:Key="LightWarningBrush"
        Color="{DynamicResource WarningLightColor}" />
    <SolidColorBrush
        x:Key="WarningBrush"
        Color="{DynamicResource WarningColor}" />
    <SolidColorBrush
        x:Key="DarkWarningBrush"
        Color="{DynamicResource WarningDarkColor}" />

    <SolidColorBrush
        x:Key="PrimaryTextBrush"
        Color="{DynamicResource PrimaryTextColor}" />
    <SolidColorBrush
        x:Key="SecondaryTextBrush"
        Color="{DynamicResource SecondaryTextColor}" />
    <SolidColorBrush
        x:Key="ThirdlyTextBrush"
        Color="{DynamicResource ThirdlyTextColor}" />

    <SolidColorBrush
        x:Key="LightBackgroundBrush"
        Color="{DynamicResource BackgroundLightColor}" />
    <SolidColorBrush
        x:Key="BackgroundBrush"
        Color="{DynamicResource BackgroundColor}" />
    <SolidColorBrush
        x:Key="DarkBackgroundBrush"
        Color="{DynamicResource BackgroundDarkColor}" />

    <!--  Border  -->
    <SolidColorBrush
        x:Key="ControlBorderBrush"
        Color="{DynamicResource ControlBorderColor}" />
    <SolidColorBrush
        x:Key="ControlDisabledBorderBrush"
        Color="{DynamicResource ControlDisabledBorderColor}" />
    <SolidColorBrush
        x:Key="ControlReadOnlyBorderBrush"
        Color="{DynamicResource ControlReadOnlyBorderColor}" />
    <SolidColorBrush
        x:Key="ControlHoveredBorderBrush"
        Color="{DynamicResource ControlHoveredBorderColor}" />
    <SolidColorBrush
        x:Key="ControlFocusedBorderBrush"
        Color="{DynamicResource ControlFocusedBorderColor}" />

    <!--  Foreground  -->
    <SolidColorBrush
        x:Key="ControlForegroundBrush"
        Color="{DynamicResource ControlForegroundColor}" />
    <SolidColorBrush
        x:Key="ControlDisabledForegroundBrush"
        Color="{DynamicResource ControlDisabledForegroundColor}" />
    <SolidColorBrush
        x:Key="ControlReadOnlyForegroundBrush"
        Color="{DynamicResource ControlReadOnlyForegroundColor}" />
    <SolidColorBrush
        x:Key="ControlHoveredForegroundBrush"
        Color="{DynamicResource ControlHoveredForegroundColor}" />
    <SolidColorBrush
        x:Key="ControlFocusedForegroundBrush"
        Color="{DynamicResource ControlFocusedForegroundColor}" />

    <!--  Background  -->
    <SolidColorBrush
        x:Key="ControlBackgroundBrush"
        Color="{DynamicResource ControlBackgroundColor}" />
    <SolidColorBrush
        x:Key="ControlDisabledBackgroundBrush"
        Color="{DynamicResource ControlDisabledBackgroundColor}" />
    <SolidColorBrush
        x:Key="ControlReadOnlyBackgroundBrush"
        Color="{DynamicResource ControlReadOnlyBackgroundColor}" />
    <SolidColorBrush
        x:Key="ControlHoveredBackgroundBrush"
        Color="{DynamicResource ControlHoveredBackgroundColor}" />
    <SolidColorBrush
        x:Key="ControlFocusedBackgroundBrush"
        Color="{DynamicResource ControlFocusedBackgroundColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{DynamicResource OnAccentColor}" />
    <SolidColorBrush x:Key="OnSuccessBrush" Color="{DynamicResource OnSuccessColor}" />
    <SolidColorBrush x:Key="OnWarningBrush" Color="{DynamicResource OnWarningColor}" />
    <SolidColorBrush x:Key="OnErrorBrush" Color="{DynamicResource OnErrorColor}" />
    <SolidColorBrush x:Key="OnInfoBrush" Color="{DynamicResource OnInfoColor}" />
    <SolidColorBrush x:Key="SelectionInactiveBrush" Color="{DynamicResource SelectionInactiveColor}" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="{DynamicResource FocusRingColor}" />
    <SolidColorBrush x:Key="WindowCloseHoverBrush" Color="{DynamicResource WindowCloseHoverColor}" />
</ResourceDictionary>
